APP_ENV=production
FLASK_DEBUG=0
# Generate a strong value, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

HIGH_RISK_THRESHOLD=0.42
AFFORDABILITY_THRESHOLD=0.30
COST_ATTENTION_APR=36.0
DIRECTORY_STALE_AFTER_DAYS=45

AUTO_METADATA_ENABLED=1
REVIEW_ANALYSIS_ENABLED=0
REVIEW_SAMPLE_SIZE=50
METADATA_CACHE_TTL_SECONDS=43200
METADATA_ERROR_CACHE_TTL_SECONDS=900

CHECK_RATE_LIMIT_PER_MINUTE=20
API_RATE_LIMIT_PER_MINUTE=30
ENABLE_API=0
TRUST_PROXY=1
FORCE_HSTS=1
DEMO_MODE=0
